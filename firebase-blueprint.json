{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated campus user profile with role and department affiliation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "faculty", "admin"] },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "departmentApproved": { "type": "boolean" },
        "certifications": { "type": "array" },
        "studentIdCode": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "uid", "email", "displayName", "role", "departmentId", "departmentApproved", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "RoleRequest": {
      "title": "RoleRequest",
      "description": "Pending request submitted during registration for faculty or admin access.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "requestedRole": { "type": "string", "enum": ["faculty", "admin"] },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "justification": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "email", "displayName", "requestedRole", "departmentId", "justification", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Department": {
      "title": "Department",
      "description": "Academic department owning laboratories and equipment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 16 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "building": { "type": "string", "minLength": 1, "maxLength": 120 },
        "headFacultyId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "building", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Laboratory": {
      "title": "Laboratory",
      "description": "Physical campus laboratory room with operating hours.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "building": { "type": "string", "minLength": 1, "maxLength": 120 },
        "room": { "type": "string", "minLength": 1, "maxLength": 64 },
        "openHour": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$", "maxLength": 5 },
        "closeHour": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$", "maxLength": 5 },
        "facultyInChargeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "capacity": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "departmentId", "building", "room", "openHour", "closeHour", "facultyInChargeId", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Shared laboratory equipment asset with specs and booking rules.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "equipmentId": { "type": "string", "minLength": 2, "maxLength": 40 },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "specs": { "type": "object" },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "laboratoryId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "building": { "type": "string", "minLength": 1, "maxLength": 120 },
        "location": { "type": "string", "minLength": 1, "maxLength": 160 },
        "quantity": { "type": "number" },
        "condition": { "type": "string", "enum": ["excellent", "good", "fair", "needs_service"] },
        "maintenanceStatus": { "type": "string", "enum": ["operational", "scheduled", "under_maintenance"] },
        "responsibleFacultyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minBookingMins": { "type": "number" },
        "maxBookingMins": { "type": "number" },
        "usageRestrictions": { "type": "string", "maxLength": 1000 },
        "requiresCertification": { "type": "boolean" },
        "requiredCertification": { "type": "string", "maxLength": 120 },
        "allowsSplitBooking": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive", "maintenance"] },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "equipmentId", "name", "category", "description", "departmentId", "laboratoryId", "building", "location", "quantity", "condition", "maintenanceStatus", "responsibleFacultyId", "minBookingMins", "maxBookingMins", "requiresCertification", "allowsSplitBooking", "isActive", "status", "imageUrl", "isDemo", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Student research or academic project linked to resource requests.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "teamMembers": { "type": "array" },
        "equipmentRequirements": { "type": "string", "maxLength": 1000 },
        "startDate": { "type": "string", "maxLength": 64 },
        "deadline": { "type": "string", "maxLength": 64 },
        "deadlineType": { "type": "string", "enum": ["exact", "end_of_day"] },
        "estimatedHours": { "type": "number" },
        "priorityJustification": { "type": "string", "maxLength": 1000 },
        "attachmentName": { "type": "string", "maxLength": 255 },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerId", "departmentId", "title", "description", "category", "startDate", "deadline", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "BookingRequest": {
      "title": "BookingRequest",
      "description": "Student request for an equipment time slot associated with a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requestedStart": { "type": "string", "maxLength": 64 },
        "requestedEnd": { "type": "string", "maxLength": 64 },
        "units": { "type": "number" },
        "requiredSpecs": { "type": "object" },
        "purpose": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["draft", "submitted", "pending_approval", "ai_recommended", "approved", "rejected", "waitlisted", "cancelled", "completed"] },
        "aiScore": { "type": "number" },
        "aiRecommendedSlot": { "type": "object" },
        "facultyNote": { "type": "string", "maxLength": 1000 },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "studentId", "projectId", "equipmentId", "departmentId", "requestedStart", "requestedEnd", "units", "status", "submittedAt", "isDemo", "createdAt", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Confirmed or completed equipment booking backed by equipmentDaySchedules.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "departmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "start": { "type": "string", "maxLength": 64 },
        "end": { "type": "string", "maxLength": 64 },
        "units": { "type": "number" },
        "status": { "type": "string", "enum": ["approved", "checked_in", "completed", "cancelled"] },
        "qrToken": { "type": "string", "maxLength": 200 },
        "checkedInAt": { "type": "string", "maxLength": 64 },
        "checkedOutAt": { "type": "string", "maxLength": 64 },
        "maintenanceConflict": { "type": "boolean" },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "requestId", "studentId", "projectId", "equipmentId", "departmentId", "start", "end", "units", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Approval": {
      "title": "Approval",
      "description": "Faculty/admin decision record for a booking request with override tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "facultyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "type": "string", "enum": ["approved", "modified", "rejected", "suggested_alternative", "more_info_requested"] },
        "isOverride": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["recorded"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "requestId", "facultyId", "decision", "isOverride", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "AllocationResult": {
      "title": "AllocationResult",
      "description": "Persisted deterministic allocation engine output for a conflict group.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "maxLength": 16 },
        "engineVersion": { "type": "string", "maxLength": 32 },
        "computedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["active", "superseded"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "equipmentId", "date", "engineVersion", "computedAt", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Maintenance": {
      "title": "Maintenance",
      "description": "Scheduled or completed equipment maintenance window.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "start": { "type": "string", "maxLength": 64 },
        "end": { "type": "string", "maxLength": 64 },
        "technician": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "equipmentId", "title", "start", "end", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification linked to booking, waitlist, or maintenance events.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "link": { "type": "string", "maxLength": 255 },
        "read": { "type": "boolean" },
        "status": { "type": "string", "enum": ["unread", "read"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "title", "message", "read", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "UsageLog": {
      "title": "UsageLog",
      "description": "Recorded equipment usage hours used for rolling 30-day fairness computation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bookingId": { "type": "string", "maxLength": 128 },
        "hours": { "type": "number" },
        "loggedAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["logged"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "studentId", "equipmentId", "hours", "loggedAt", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Waitlist": {
      "title": "Waitlist",
      "description": "Waitlist entry for an unavailable slot, ordered by fairness model.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "desiredStart": { "type": "string", "maxLength": 64 },
        "desiredEnd": { "type": "string", "maxLength": 64 },
        "fairnessScore": { "type": "number" },
        "status": { "type": "string", "enum": ["waiting", "notified", "fulfilled", "cancelled"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "requestId", "studentId", "equipmentId", "desiredStart", "desiredEnd", "fairnessScore", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global platform configuration including allocation weights, fair-use limit, and demo access toggle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fairUseLimitHours": { "type": "number" },
        "enforceFairUseHard": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "EquipmentDaySchedule": {
      "title": "EquipmentDaySchedule",
      "description": "Atomic per-equipment per-day schedule intervals preventing double bookings in transactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "equipmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "intervals": { "type": "array" },
        "status": { "type": "string", "enum": ["active"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "equipmentId", "date", "intervals", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only audit trail for approvals, overrides, allocations, and configuration changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "entityType": { "type": "string", "minLength": 2, "maxLength": 64 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "detail": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["recorded"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "actorId", "action", "entityType", "entityId", "detail", "status", "isDemo", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "User profiles" },
    "/roleRequests/{requestId}": { "schema": { "$ref": "#/entities/RoleRequest" }, "description": "Elevated role requests" },
    "/departments/{departmentId}": { "schema": { "$ref": "#/entities/Department" }, "description": "Campus departments" },
    "/laboratories/{labId}": { "schema": { "$ref": "#/entities/Laboratory" }, "description": "Campus laboratories" },
    "/equipment/{equipmentDocId}": { "schema": { "$ref": "#/entities/Equipment" }, "description": "Laboratory equipment catalog" },
    "/projects/{projectId}": { "schema": { "$ref": "#/entities/Project" }, "description": "Student research projects" },
    "/bookingRequests/{requestId}": { "schema": { "$ref": "#/entities/BookingRequest" }, "description": "Resource booking requests" },
    "/bookings/{bookingId}": { "schema": { "$ref": "#/entities/Booking" }, "description": "Confirmed bookings" },
    "/approvals/{approvalId}": { "schema": { "$ref": "#/entities/Approval" }, "description": "Faculty approval decisions" },
    "/allocationResults/{resultId}": { "schema": { "$ref": "#/entities/AllocationResult" }, "description": "Engine allocation results" },
    "/maintenance/{maintenanceId}": { "schema": { "$ref": "#/entities/Maintenance" }, "description": "Equipment maintenance records" },
    "/notifications/{notificationId}": { "schema": { "$ref": "#/entities/Notification" }, "description": "User notifications" },
    "/usageLogs/{logId}": { "schema": { "$ref": "#/entities/UsageLog" }, "description": "Historical equipment usage logs" },
    "/waitlists/{waitlistId}": { "schema": { "$ref": "#/entities/Waitlist" }, "description": "Equipment slot waitlists" },
    "/settings/{settingId}": { "schema": { "$ref": "#/entities/Settings" }, "description": "Platform configuration documents" },
    "/equipmentDaySchedules/{scheduleId}": { "schema": { "$ref": "#/entities/EquipmentDaySchedule" }, "description": "Atomic daily schedule intervals" },
    "/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Append-only audit trail" }
  }
}
